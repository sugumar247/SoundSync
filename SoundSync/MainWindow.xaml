<Window x:Class="SoundSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundSync" Height="580" Width="680"
        Background="#121316" WindowStartupLocation="CenterScreen"
        Icon="logo.png" ResizeMode="CanMinimize"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#181A1F"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#00B0FF"/>
        <SolidColorBrush x:Key="WarningRedBrush" Color="#FF3D00"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6C727F"/>
        <SolidColorBrush x:Key="ConsoleBorderBrush" Color="#2A2D35"/>

        <Style x:Key="ConsoleSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Name="TrackBackground" 
                                    Background="#0B0C0E" 
                                    BorderBrush="#25272E"
                                    BorderThickness="1"
                                    Height="4" 
                                    CornerRadius="2" 
                                    VerticalAlignment="Center" 
                                    Margin="2,0"/>
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="12" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Border Background="#2E3138" 
                                                            BorderBrush="#4C505C" 
                                                            BorderThickness="1" 
                                                            CornerRadius="1">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1.5" Direction="270" Opacity="0.6"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Rectangle Width="2" Height="12" Fill="#FF3D00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DelaySliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Name="TrackBackground" 
                                    Background="#0B0C0E" 
                                    BorderBrush="#25272E"
                                    BorderThickness="1"
                                    Height="4" 
                                    CornerRadius="2" 
                                    VerticalAlignment="Center" 
                                    Margin="2,0"/>
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="12" Height="20">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Border Background="#2E3138" 
                                                            BorderBrush="#4C505C" 
                                                            BorderThickness="1" 
                                                            CornerRadius="1">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="3" ShadowDepth="1.5" Direction="270" Opacity="0.6"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Rectangle Width="2" Height="12" Fill="#FFC400" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EqSliderStyle" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Name="TrackBackground" 
                                    Background="#090A0C" 
                                    BorderBrush="#1E2026"
                                    BorderThickness="1"
                                    Height="3" 
                                    CornerRadius="1" 
                                    VerticalAlignment="Center"/>
                            <Track Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="8" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#454A56" 
                                                        BorderBrush="#606675" 
                                                        BorderThickness="1" 
                                                        CornerRadius="1">
                                                    <Rectangle Width="2" Height="8" Fill="#00B0FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VuMeterStyle" TargetType="ProgressBar">
            <Setter Property="Background" Value="#090A0C"/>
            <Setter Property="BorderBrush" Value="#1E2026"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Maximum" Value="1.0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="1"/>
                            <Rectangle x:Name="PART_Track" />
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Grid x:Name="IndicatorGrid">
                                    <Rectangle x:Name="IndicatorRectangle">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00E676" Offset="0.0"/>
                                                <GradientStop Color="#FFD600" Offset="0.75"/>
                                                <GradientStop Color="#FF1744" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HardwareCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent" Cursor="Hand">
                            <BulletDecorator.Bullet>
                                <Grid Width="16" Height="16">
                                    <Border x:Name="Border" 
                                            Background="#0B0C0E" 
                                            BorderBrush="#2A2D35" 
                                            BorderThickness="1.5" 
                                            CornerRadius="2" />
                                    <Ellipse x:Name="CheckMark" 
                                             Width="8" Height="8" 
                                             Fill="#00E676" 
                                             Visibility="Collapsed"/>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#00E676"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#6C727F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Border BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="SOUNDSYNC" FontSize="20" FontWeight="Black" Foreground="White"/>
                        <Border Background="#1C2E24" CornerRadius="3" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="V1.1.1" Foreground="#00FF66" FontSize="10" FontFamily="Consolas" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Button x:Name="RefreshButton" Content="[ ↻ RE-SCAN HARDWARE ]" HorizontalAlignment="Right"
                            Background="Transparent" Foreground="{StaticResource AccentBlueBrush}" FontSize="12" FontFamily="Consolas" FontWeight="Bold" 
                            BorderThickness="0" Cursor="Hand" Click="RefreshButton_Click"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="50"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="AUDIO OUT CHANNEL" Grid.Column="0" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="SIGNAL" Grid.Column="1" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="VOLUME" Grid.Column="2" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="DELAY" Grid.Column="3" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="LATENCY" Grid.Column="4" FontSize="10" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackgroundBrush}" BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5">
            <ListBox x:Name="DeviceListBox" Background="Transparent" BorderThickness="0" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 HorizontalContentAlignment="Stretch">  
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#1B1E24"/>
                        <Setter Property="Padding" Value="5,10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                          Style="{StaticResource HardwareCheckBoxStyle}"
                                          Grid.Column="0" VerticalAlignment="Center"
                                          PreviewMouseDown="CheckBox_PreviewMouseDown"/>

                                <ProgressBar Value="{Binding PeakLevel, Mode=OneWay}" 
                                             Style="{StaticResource VuMeterStyle}" 
                                             Height="10" Grid.Column="1" Margin="8,0" VerticalAlignment="Center"/>

                                <Slider Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding Volume}" 
                                        Style="{StaticResource ConsoleSliderStyle}"
                                        VerticalAlignment="Center" Margin="5,0"/>

                                <Slider Grid.Column="3" Minimum="-200" Maximum="200" Value="{Binding Delay}" 
                                        Style="{StaticResource DelaySliderStyle}"
                                        VerticalAlignment="Center" Margin="5,0"/>

                                <TextBlock Grid.Column="4" Text="{Binding Delay, StringFormat={}{0}ms}" 
                                           FontFamily="Consolas" FontSize="11" Foreground="#FFE082" 
                                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="24,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="BASS" Grid.Column="0" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Slider Grid.Column="1" Minimum="-12" Maximum="12" Value="{Binding Bass}" 
                                        Style="{StaticResource EqSliderStyle}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                                <TextBlock Text="MID" Grid.Column="2" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Slider Grid.Column="3" Minimum="-12" Maximum="12" Value="{Binding Mid}" 
                                        Style="{StaticResource EqSliderStyle}" VerticalAlignment="Center" Margin="0,0,20,0"/>

                                <TextBlock Text="TREBLE" Grid.Column="4" FontSize="9" FontFamily="Consolas" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Slider Grid.Column="5" Minimum="-12" Maximum="12" Value="{Binding Treble}" 
                                        Style="{StaticResource EqSliderStyle}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="3" Background="#090A0C" BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1" CornerRadius="3" Margin="0,15,0,15" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="MONITOR_LOG >" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Status: Disconnected" Grid.Column="1" Margin="10,0,0,0"
                           FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource WarningRedBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Button x:Name="ConnectButton" Content="ENGAGE SOUNDSYNC SYSTEM" Grid.Row="4" Height="45" Background="#1A2D40"
                Foreground="#00B0FF" FontSize="14" FontFamily="Consolas" FontWeight="Black" Cursor="Hand"
                Click="ConnectButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="MasterBorder" Background="{TemplateBinding Background}" 
                            BorderBrush="#00B0FF" BorderThickness="1.5" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MasterBorder" Property="Background" Value="#253E56"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock Text="CONSOLE SHORTCUTS:" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <Border Background="#1A1D24" BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,3" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#2E323D" CornerRadius="2" Padding="4,1,4,2" Margin="0,0,5,0" VerticalAlignment="Center">
                        <TextBlock Text="C" Foreground="White" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Toggle Connect" Foreground="#A9AEBB" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#1A1D24" BorderBrush="{StaticResource ConsoleBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#2E323D" CornerRadius="2" Padding="4,1,4,2" Margin="0,0,5,0" VerticalAlignment="Center">
                        <TextBlock Text="M" Foreground="White" FontFamily="Consolas" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Mute Channels" Foreground="#A9AEBB" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Window>