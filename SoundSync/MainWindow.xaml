<Window x:Class="SoundSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SoundSync" Height="450" Width="550"
        Background="#1E1E1E" WindowStartupLocation="CenterScreen"
        Icon="logo.png">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="SoundSync" FontSize="28" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,0,0,5"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Select devices and adjust volume:" Foreground="#AAAAAA"
                       FontSize="14" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Content="↻ Refresh List" HorizontalAlignment="Right"
                    Background="Transparent" Foreground="#007ACC" FontSize="14" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Click="RefreshButton_Click"/>
        </Grid>

        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="8" Padding="10">
            <ListBox x:Name="DeviceListBox" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                      Foreground="White" FontSize="14" VerticalAlignment="Center"
                                      PreviewMouseDown="CheckBox_PreviewMouseDown"/>

                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume}"
                                    VerticalAlignment="Center" Margin="10,0,0,0" ToolTip="Volume"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="StatusText" Text="Status: Disconnected" Grid.Row="3" Foreground="#FF5555"
                   FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,10"/>

        <Button x:Name="ConnectButton" Content="CONNECT" Grid.Row="4" Height="45" Background="#007ACC"
                Foreground="White" FontSize="16" FontWeight="Bold" Cursor="Hand"
                Click="ConnectButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>